from typing import Any
from typing import Optional

import flask
from flask import views
from graphql import GraphQLSchema
from graphql.error import GraphQLError

class FileUploadGraphQLView(views.View):
    schema: GraphQLSchema
    pretty: bool
    batch: bool
    def __init__(self, **kwargs: Any) -> None: ...
    def parse_body(self) -> Any: ...
    def should_display_graphiql(self) -> bool: ...
    def get_executor(self) -> Any: ...
    def get_backend(self) -> Any: ...
    def get_root_value(self) -> Any: ...
    def get_context(self) -> flask.Request: ...
    def get_middleware(self) -> Any: ...
    def render_graphiql(self, params: Any, result: Any) -> str: ...
    @staticmethod
    def format_error(error: GraphQLError) -> dict[str, Any]: ...
    @staticmethod
    def encode(data: Any, pretty: Optional[bool | str] = ...) -> str: ...
