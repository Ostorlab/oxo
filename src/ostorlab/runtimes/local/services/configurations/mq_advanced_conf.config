%% advanced.config
%% The consumer timeout is disabled due to some agents like nmap who takes too much time to finish their task and acknowledge the message.
%% The max_message_size is increased to support large APK files (up to 512 MB).
%% The total_memory_available_override_value is set to 10 GiB (matching MQ_MEMORY_RESERVATION) so RabbitMQ computes its memory watermark and paging threshold against the universe's 10 GiB allocation instead of total host RAM.
[
    {rabbit, [
        {consumer_timeout, undefined},
        {max_message_size, 536870912},
        {total_memory_available_override_value, 10737418240}
    ]}
].